        "shards": {
          "default": 4,
          "minimum": 1,
          "title": "Shards",
          "type": "integer"
        },
        "monitoring_repetitions": {
          "default": 3,
          "minimum": 1,
          "title": "Monitoring Repetitions",
          "type": "integer"
        }
      },
      "title": "NightlyQuarantineJob",
      "type": "object"
    },
