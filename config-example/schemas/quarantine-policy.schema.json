    "MassFailure": {
      "additionalProperties": false,
      "properties": {
        "ratio": {
          "default": 0.2,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Ratio",
          "type": "number"
        },
        "min_tests": {
          "default": 50,
          "minimum": 1,
          "title": "Min Tests",
          "type": "integer"
        },
        "single_fingerprint_tests": {
          "default": 25,
          "minimum": 1,
          "title": "Single Fingerprint Tests",
          "type": "integer"
        }
      },
      "title": "MassFailure",
      "type": "object"
    },
    "NeverQuarantine": {
      "additionalProperties": false,
      "properties": {
        "paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "tests": {
          "items": {
            "pattern": "^(pytest|playwright|jest)::[^:]+::.+$",
            "type": "string"
          },
          "title": "Tests",
          "type": "array"
        },
        "markers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Markers",
          "type": "array"
        }
      },
      "title": "NeverQuarantine",
      "type": "object"
    },
    "NightlyQuarantineJob": {
      "additionalProperties": false,
