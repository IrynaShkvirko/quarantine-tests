{
  "$defs": {
    "Reason": {
      "enum": [
        "timing",
        "order_dependency",
        "concurrency",
        "external_dependency",
        "test_data_env",
        "nondeterminism",
        "ci_infra",
        "product_bug",
        "untriaged"
