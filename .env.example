# Copy to .env (gitignored): cp .env.example .env
# Local-development values only. Never reuse these anywhere real.

# --- Backend (read by app/settings.py) ---
# Used by tools run on the host (pytest -m integration, psql, alembic). Inside docker compose
# the services build their own URL that points at the `db` container.
FQ_DATABASE_URL=postgresql+psycopg://fq:fq-local-password@localhost:5433/fq
# DEBUG | INFO | WARNING | ERROR | CRITICAL
FQ_LOG_LEVEL=INFO
# local | ci | prod (local = readable console logs, ci and prod = JSON logs)
FQ_ENV=local

# --- Postgres container ---
POSTGRES_PASSWORD=fq-local-password
# Password of the read-only role Grafana uses (created by docker/postgres/init.sh).
GRAFANA_RO_PASSWORD=grafana-ro-local-password
# Host ports (loopback only). 5433 avoids clashing with a Postgres already on 5432.
FQ_DB_HOST_PORT=5433
FQ_API_HOST_PORT=8000
GRAFANA_HOST_PORT=3000

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-local-password

# --- Placeholders for later milestones (not used yet) ---
# FQ_GITHUB_APP_ID=
# FQ_JIRA_BASE_URL=
# FQ_SLACK_BOT_TOKEN=
